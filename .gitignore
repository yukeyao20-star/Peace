# ---- Godot ----
project/.godot/
project/*.import
project/**/*.import
# 注：export_presets.cfg 是发布配置（三平台预设/图标/过滤），无本机绝对路径，需入库

# GDExtension 编译产物（保留 .gdextension 描述文件本身）
project/bin/*/
!project/bin/*.gdextension

# ---- 构建产物 ----
bin/
build/
*.o
*.os
*.obj
*.a
*.dylib
*.so
*.dll
*.lib
*.exp
*.pdb

# ---- 本机构建 / 发布产物 ----
builds/
dist/
release/
project/export/
__pycache__/
compile_commands.json
*.old
*.tmp

# ---- SCons ----
.sconsign.dblite
.scons-cache/
.sconf_temp/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- QA 诊断产物（单次截图/差分图，体积大且不可复现，不入库） ----
docs/qa/

# ---- 官网上托管的安装包（发布产物，走 dist/ 重新导出即可） ----
site/download/

# ---- WorkBuddy AI 会话/记忆目录 ----
.workbuddy-ai/

# ---- 音频素材（体积大，不入库；本地保留，游戏内代码有合成兜底/本地资源优先） ----
project/assets/audio/
*.mp3
*.wav
*.ogg
*.flac

# ---- 本地草稿与智能体会话状态（不入库） ----
tmp/
.agent/
